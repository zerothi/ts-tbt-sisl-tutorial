TBT.HS DEVICE.nc

# Also calculate the bulk DOS for the electrodes
TBT.DOS.Elecs true
TBT.DOS.A true
TBT.DOS.A.All true
TBT.T.All true
TBT.Current.Orb true

TBT.Symmetry.TimeReversal false
TBT.k [ 1 51 1]

%block TBT.Contours
    line
%endblock TBT.Contours

%block TBT.Contour.line
  part line
     from -1. eV to 1. eV
      delta 0.01 eV
        method mid-rule
%endblock TBT.Contour.line

%block TBT.Elec.Left
  HS ELEC.nc
  semi-inf-direction -a1
  electrode-position 1
%endblock
%block TBT.Elec.Right
  HS ELEC.nc
  semi-inf-direction +a1
  electrode-position end -1
%endblock

TBT.BTD.Pivot.Device atom+GPS
